\section{Proof of Posterior Consistency}
\label{appx:consistency}

Throughout, one context is fixed and its rate is written $\lambda$, with true value $\lambda^{*} > 0$.
Let $\mathcal{F}_{t}$ be the filtration generated by $(u_1, y_1, \dots, u_t, y_t)$ and let the policy be adapted, so that $u_{i}$ is $\mathcal{F}_{i-1}$-measurable and may depend on everything observed before step $i$.
Write $f_i = f(u_i)$, and
%
\begin{equation*}
    T_t = \sum_{i \leq t} y_i \,, \qquad F_t = \sum_{i \leq t} f_i \,, \qquad \nu_t = \nu + T_t \,, \qquad b_t = b + 2 F_t \,,
\end{equation*}
%
so that the posterior is $\Gig(\lambda \given \nu_t, a, b_t)$ by repeated use of \eqref{eq:posterior}.
A subscript $t$ marks the quantities of Lemma~\ref{lem:gig_moments} under this posterior, such as $\eta_t$, $\omega_t$, $\mu_t$ and $V_t$, so everything below is a statement about the ratio $R$.

\subsection{A Bracket on the Bessel Ratio}

The proof needs no asymptotic expansion of $K$.
An exact two-sided bound follows from the recurrence alone, and it is the only property of the Bessel functions used.

\begin{lemma}
    \label{lem:bessel_bracket}
    For every $z > 0$ and every real $\alpha$,
    %
    \begin{equation}
        R_{\alpha}(z) > \frac{2\alpha}{z} \,,
        \label{eq:bracket_lower}
    \end{equation}
    %
    and if in addition $\alpha > 1$,
    %
    \begin{equation}
        R_{\alpha}(z) < \frac{2\alpha}{z} + \frac{z}{2(\alpha - 1)} \,.
        \label{eq:bracket_upper}
    \end{equation}
\end{lemma}

\begin{proof}
    By Eqs.~(A.15) and (A.16) of \citet{jorgensen1982statistical}, the ratio satisfies the exact recursion
    %
    \begin{equation}
        R_{\alpha}(z) = \frac{2\alpha}{z} + \frac{1}{R_{\alpha - 1}(z)} \,,
        \label{eq:ratio_recursion}
    \end{equation}
    %
    valid for every real $\alpha$.
    As $K_{\alpha}$ is strictly positive on $(0, \infty)$ for every real order, $R_{\alpha - 1}(z) > 0$, so the second term of \eqref{eq:ratio_recursion} is strictly positive and \eqref{eq:bracket_lower} follows.
    Applying \eqref{eq:bracket_lower} at order $\alpha - 1$, which is a positive lower bound exactly when $\alpha > 1$, gives $R_{\alpha - 1}(z) > 2(\alpha - 1)/z$ and hence $1/R_{\alpha - 1}(z) < z / 2(\alpha - 1)$.
    Substituting into \eqref{eq:ratio_recursion} gives \eqref{eq:bracket_upper}.
\end{proof}

\subsection{A Law of Large Numbers for the Accumulated Count}

\begin{lemma}
    \label{lem:lln}
    On the event $\{F_t \to \infty\}$, $T_t / F_t \to \lambda^{*}$ almost surely, and $\nu_t \to \infty$.
\end{lemma}

\begin{proof}
    Under $\lambda^{*}$ the conditional law of $y_i$ given $\mathcal{F}_{i - 1}$ is Poisson with mean $f_i \lambda^{*}$, since $f_i$ is $\mathcal{F}_{i-1}$-measurable.
    Hence $M_t = T_t - \lambda^{*} F_t$ is a square-integrable martingale with predictable quadratic variation
    %
    \begin{equation*}
        \langle M \rangle_t = \sum_{i \leq t} \Var{}{y_i \given \mathcal{F}_{i-1}} = \lambda^{*} F_t \,.
    \end{equation*}
    %
    On $\{F_t \to \infty\}$ we have $\langle M \rangle_{\infty} = \infty$, so the strong law for square-integrable martingales gives $M_t / \langle M \rangle_t \to 0$ almost surely, that is $T_t / F_t \to \lambda^{*}$.
    Since $\lambda^{*} > 0$ and $F_t \to \infty$, also $T_t \to \infty$ and therefore $\nu_t = \nu + T_t \to \infty$.
\end{proof}

The adaptivity of the policy is handled entirely by this lemma, and it is the only place it is needed.
Nothing later distinguishes a sequential design from one fixed in advance.

\subsection{Proof of Proposition~\ref{prop:consistency}}

\begin{proof}
    Work first on $\{F_{\infty} = \infty\}$, intersected with the almost sure event of Lemma~\ref{lem:lln}, on which $\nu_t \to \infty$ and so $\nu_t > 1$ for all large $t$.

    \paragraph{The posterior mean.}
    Applying Lemma~\ref{lem:bessel_bracket} at $\alpha = \nu_t$ and $z = \omega_t$ to $\mu_t = \eta_t R_{\nu_t}(\omega_t)$, and simplifying with the identities of Lemma~\ref{lem:gig_moments},
    %
    \begin{equation}
        \frac{2 \nu_t}{b_t} \; < \; \mu_t \; < \; \frac{2 \nu_t}{b_t} + \frac{a}{2 (\nu_t - 1)} \,.
        \label{eq:mean_bracket}
    \end{equation}
    %
    The width of the bracket is $a / 2(\nu_t - 1) \to 0$, and the leading term satisfies
    %
    \begin{equation}
        \frac{2 \nu_t}{b_t} = \frac{2 F_t}{b + 2 F_t} \cdot \frac{\nu + T_t}{F_t} \longrightarrow 1 \cdot \lambda^{*}
        \label{eq:mean_limit}
    \end{equation}
    %
    by Lemma~\ref{lem:lln}.
    Hence the posterior mean converges to $\lambda^{*}$ almost surely.
    Note that the first scale parameter $a$ appears nowhere except in the width of \eqref{eq:mean_bracket}, which is the formal content of the observation that $a$ is never revised and never needs to be.

    \paragraph{The posterior variance.}
    By \eqref{eq:gig_moments}, $V_t = \eta_t^{2} R_{\nu_t}(R_{\nu_t + 1} - R_{\nu_t})$, with the argument $\omega_t$ suppressed.
    Applying \eqref{eq:ratio_recursion} at orders $\nu_t + 1$ and $\nu_t$ and discarding the negative term $-1/R_{\nu_t - 1}$,
    %
    \begin{equation*}
        R_{\nu_t + 1} - R_{\nu_t} = \frac{2}{\omega_t} + \frac{1}{R_{\nu_t}} - \frac{1}{R_{\nu_t - 1}} < \frac{2}{\omega_t} + \frac{\omega_t}{2 \nu_t} \,,
    \end{equation*}
    %
    where \eqref{eq:bracket_lower} bounds $1 / R_{\nu_t}$.
    Combining this with \eqref{eq:bracket_upper} for $R_{\nu_t}$ and expanding the product gives
    %
    \begin{equation}
        V_t \; < \; \frac{4 \nu_t}{b_t^{2}} + \frac{a}{b_t} \Big( 1 + \frac{1}{\nu_t - 1} \Big) + \frac{a^{2}}{4 \nu_t (\nu_t - 1)} \,.
        \label{eq:variance_bound}
    \end{equation}
    %
    By Lemma~\ref{lem:lln}, $\nu_t / F_t \to \lambda^{*}$ and $b_t / F_t \to 2$, so the first term of \eqref{eq:variance_bound} is asymptotic to $\lambda^{*} / F_t$, the second is of order $1/F_t$ and the third of order $1/F_t^{2}$.
    The posterior variance is therefore $O(1/F_t)$ and vanishes.

    \paragraph{Concentration.}
    The posterior mean-squared error decomposes as $\Ex{p(\lambda \given \mathcal{D}_t)}{(\lambda - \lambda^{*})^{2}} = V_t + (\mu_t - \lambda^{*})^{2}$, and both terms vanish almost surely by the two paragraphs above, which is \eqref{eq:consistency}.
    Concentration follows by Chebyshev's inequality, since for any $\epsilon > 0$,
    %
    \begin{equation*}
        p\big( |\lambda - \lambda^{*}| > \epsilon \given \mathcal{D}_t \big) \leq \epsilon^{-2} \Ex{p(\lambda \given \mathcal{D}_t)}{(\lambda - \lambda^{*})^{2}} \longrightarrow 0 \,.
    \end{equation*}
    %
    The sharper statement \eqref{eq:consistency_rate} needs a finer bound on the same ratio and is proved in Appendix~\ref{appx:consistency_constant}.

    \paragraph{The converse.}
    Work now on $\{F_{\infty} < \infty\}$.
    Then $\sum_{i} \Pr(y_i > 0 \given \mathcal{F}_{i-1}) = \sum_{i} (1 - \exp(-f_i \lambda^{*})) \leq \lambda^{*} F_{\infty} < \infty$, so by the conditional Borel--Cantelli lemma only finitely many observations are nonzero almost surely.
    Hence $T_t \to T_{\infty} < \infty$, and the posterior converges to $\Gig(\lambda \given \nu + T_{\infty}, a, b + 2 F_{\infty})$, which has strictly positive variance because $b + 2F_\infty < \infty$.
    The posterior does not concentrate, at any $\lambda^{*}$.
\end{proof}

\subsection{The Constant in the Rate}
\label{appx:consistency_constant}

Bound \eqref{eq:variance_bound} gives the order $1/F_t$ but not the sharp constant, because its second term contributes at the same order as the first.
The looseness is an artefact of bracketing $R_{\nu_t}$ and $R_{\nu_t + 1} - R_{\nu_t}$ separately, when the variance is a difference of two nearly equal quantities.
Substituting \eqref{eq:ratio_recursion} into itself once more sharpens \eqref{eq:bracket_upper} to
%
\begin{equation}
    R_{\alpha}(z) = \frac{2\alpha}{z} + \frac{z}{2(\alpha - 1)} + O(z^{3}/\alpha^{3}) \,,
    \label{eq:ratio_expansion}
\end{equation}
%
uniformly as $\alpha / z \to \infty$, which holds here because $\nu_t / \omega_t$ grows like $\lambda^{*} \sqrt{F_t / 2a}$.
The correction term must be kept at $\alpha - 1$ rather than $\alpha$, since the two differ by $O(z/\alpha^{2})$ and that is larger than $O(z^{3}/\alpha^{3})$ in this regime.
Differencing \eqref{eq:ratio_expansion} at consecutive orders cancels the correction to leading order, because $z/2\alpha - z/2(\alpha - 1) = -z / 2\alpha(\alpha - 1)$, and leaves $R_{\nu_t + 1} - R_{\nu_t} = 2/\omega_t + O(\omega_t / \nu_t^{2})$.
Hence
%
\begin{equation}
    F_t V_t = \frac{4 \nu_t F_t}{b_t^{2}} \big( 1 + o(1) \big) \longrightarrow \lambda^{*} \,,
    \label{eq:variance_rate}
\end{equation}
%
which is the inverse Fisher information of a Poisson observed at total exposure $F_t$ and proves \eqref{eq:consistency_rate}.
Simulation agrees.
Across true rates $\lambda^{*} \in \{0.2, 3, 50\}$, orders $\nu \in \{-3, -0.5, 2\}$ and a prior mean deliberately set to $1$ in every case, the ratio $F_t V_t / \lambda^{*}$ reaches $1.000$ to $1.007$ by $F_t = 10^{5}$.

\section{Proof of Proposition~\ref{prop:starvation}}
\label{appx:starvation}

\begin{lemma}
    \label{lem:eig_bound}
    Under a belief $\Gig(\lambda \given \nu, a, b)$ with $a, b > 0$, $\nu \in \mathbb{R}$, mean $\mu$ and variance $V$, every design with $f(u) > 0$ has
    %
    \begin{equation}
        0 < G(u) \leq f(u) \frac{V}{\mu} < \frac{2 f(u)}{b} \,.
        \label{eq:eig_bound}
    \end{equation}
\end{lemma}

\begin{proof}
    For the last inequality, \eqref{eq:gig_moments} gives $V / \mu = \eta (R_{\nu + 1} - R_{\nu})$.
    Subtracting \eqref{eq:ratio_recursion} at order $\nu$ from the same at order $\nu + 1$ gives $R_{\nu + 1} - R_{\nu} = 2/\omega + 1/R_{\nu} - 1/R_{\nu - 1}$.
    This is below $2/\omega$, because $R_{\nu} / R_{\nu - 1} = K_{\nu + 1} K_{\nu - 1} / K_{\nu}^{2}$ exceeds $1$ for every real $\nu$ \citep[Theorem~4.1]{jorgensen1982statistical}, so $V / \mu < 2 \eta / \omega = 2 / b$.

    For the middle inequality, let $Q = \mathcal{P}(y \given f(u) \mu)$.
    Then $D_{\text{KL}}[\mathcal{P}(y \given f(u) \lambda) \,\|\, Q] = f(u) \big( \lambda \log(\lambda / \mu) - \lambda + \mu \big)$, which $\log x \leq x - 1$ bounds by $f(u) (\lambda - \mu)^{2} / \mu$, with expectation $f(u) V / \mu$ under the belief.
    Write \eqref{eq:eig} as $\Ex{p(\lambda \given \mathcal{D})}{D_{\text{KL}}[\mathcal{P}(y \given f(u) \lambda) \,\|\, p(y \given u, \mathcal{D})]}$, which is the same mutual information.
    Adding and subtracting $\log Q(y)$ inside the divergence gives
    %
    \begin{equation*}
        G(u) = \Ex{p(\lambda \given \mathcal{D})}{D_{\text{KL}}\big[ \mathcal{P}\big(y \given f(u) \lambda\big) \,\|\, Q \big]} - D_{\text{KL}}\big[ p(y \given u, \mathcal{D}) \,\|\, Q \big] \leq f(u) \frac{V}{\mu} \,,
    \end{equation*}
    %
    since the first term is finite by the bound just given and the second is non-negative.

    For the first inequality, $G(u) = 0$ would make $y$ independent of $\lambda$.
    It is not, because $p(y = 0 \given \lambda, u) = \exp(-f(u) \lambda)$ is strictly decreasing in $\lambda$ and the belief is not a point mass.
\end{proof}

\begin{proof}[Proof of Proposition~\ref{prop:starvation}]
    Let $\bar{r} = \max_{u \in \mathcal{U}} f(u) / c(u)$ and $\underline{f} = \min_{u \in \mathcal{U}} f(u)$, both finite and positive because $\mathcal{U}$ is finite.
    After $t$ steps context $k$ holds the belief $\Gig(\lambda_k \given \nu_{k,t}, a_k, b_{k,t})$ with $b_{k,t} = b_k + 2 F_{k,t}$, whatever counts it has returned.
    Write $G_t$ for \eqref{eq:eig} under the beliefs after $t$ steps, so that $u_{t + 1}$ maximises $G_t(u) / c(u)$.
    Because the beliefs factorise, $G_t(u)$ for $u \in \mathcal{U}_k$ depends on the belief at context $k$ alone.
    Lemma~\ref{lem:eig_bound} holds at every order, so for every $t$ and every $u \in \mathcal{U}_k$,
    %
    \begin{equation}
        0 < \frac{G_t(u)}{c(u)} < \frac{2 \bar{r}}{b_{k,t}} \,.
        \label{eq:score_envelope}
    \end{equation}

    Let $A$ be the set of contexts selected infinitely often, which is not empty because one of finitely many contexts is selected at every step.
    Suppose that some context $j$ is not in $A$.
    Then there is a step $t_0$ after which no context outside $A$ is selected.
    The belief at $j$ is therefore the same at every $t \geq t_0$, and so are the scores of $\mathcal{U}_j$, the largest of which, $\iota = \max_{u \in \mathcal{U}_j} G_{t_0}(u) / c(u)$, is positive by \eqref{eq:score_envelope}.
    Every selection at context $k$ raises $b_{k,t}$ by at least $2 \underline{f}$, so $b_{k,t} \to \infty$ for every $k \in A$.
    Since $A$ is finite and $b_{k,t}$ is non-decreasing in $t$, there is a $t_1 \geq t_0$ with $2 \bar{r} / b_{k,t} < \iota$ for every $k \in A$ and every $t \geq t_1$.
    For $t \geq t_1$, \eqref{eq:score_envelope} then puts every design at a context in $A$ below $\iota$, which some design at $j$ attains, so $u_{t + 1}$ is at a context outside $A$.
    This contradicts the choice of $t_0$, so $A$ contains every context.
    Each of the infinitely many selections at context $k$ adds at least $\underline{f}$ to $F_{k,t}$, so $F_{k,t} \to \infty$.

    The last claim is Proposition~\ref{prop:consistency} at each context.
    Its proof carries over with $\mathcal{F}_t$ generated by the data of all contexts and with $f_i$ and $y_i$ set to zero at the steps that select another context, since the policy is adapted to this filtration when ties are broken without reference to future counts.
\end{proof}

\section{Proof of Lemma~\ref{lem:sichel_tail}}
\label{appx:sichel_tail}

\begin{proof}
    For (i), fix $z > 0$. The normalising constant of \eqref{eq:gig} gives $K_{\kappa}(z) = \tfrac{1}{2} \int_{0}^{\infty} s^{\kappa - 1} e^{-z(s + 1/s)/2} \, ds$, and substituting $s = 2t/z$,
    %
    \begin{equation*}
        K_{\kappa}(z) = \tfrac{1}{2} \Gamma(\kappa) \Big( \frac{2}{z} \Big)^{\kappa} \, \mathbb{E}\big[ e^{-z^{2} / (4 T_{\kappa})} \big] \,,
    \end{equation*}
    %
    where $T_{\kappa}$ is gamma distributed with shape $\kappa$ and unit rate.
    As $\kappa \to \infty$, $T_{\kappa} \to \infty$ in probability and the integrand is bounded by $1$, so the expectation tends to $1$ and $K_{\kappa}(z) = \tfrac{1}{2} \Gamma(\kappa) (2/z)^{\kappa} (1 + o(1))$.
    Applied to \eqref{eq:sichel} at $\kappa = \nu + y$ and $z = \omega_u$, and using $\eta_u / \omega_u = 1/(b + 2f)$, this gives
    %
    \begin{equation*}
        p(y \given u, \mathcal{D}) = \Big( \frac{2 f \eta_u}{\omega_u} \Big)^{y} \frac{\Gamma(\nu + y)}{\Gamma(y + 1)} \Big( \frac{2 \eta_u}{\eta \, \omega_u} \Big)^{\nu} \frac{1 + o(1)}{2 K_{\nu}(\omega)}
        = (1 - q) \, C \, y^{\nu - 1} q^{y} \big(1 + o(1)\big) \,,
    \end{equation*}
    %
    since $\Gamma(\nu + y) / \Gamma(y + 1) = y^{\nu - 1}(1 + o(1))$.
    Successive terms of this form have ratio $q (1 + 1/y)^{\nu - 1} \to q < 1$, so summing from $y$ to infinity gives the stated $\bar{F}(y)$.
    The negative binomial with shape $r$ and success probability $\beta / (\beta + f)$ has mass function $\binom{y + r - 1}{y} (\beta/(\beta + f))^{r} q_{\Gamma}^{y}$, and the same argument applies.

    For (ii), the predictive mean and variance are $f \mu$ and $f \mu + f^{2} V$, so matching them at one exposure matches $\mu$ and $V$, and so matches them at every exposure.
    A gamma prior with mean $\mu$ and variance $V$ has rate $\beta = \mu / V$.
    The proof of Lemma~\ref{lem:eig_bound} shows $V / \mu < 2 / b$, which is $b < 2 \beta$, so $q = 2f/(b + 2f) > 2f/(2\beta + 2f) = q_{\Gamma}$.
    By (i), the ratio $\bar{F}(y) / \bar{F}_{\Gamma}(y)$ equals a positive constant times $y^{\nu - r} (q / q_{\Gamma})^{y} (1 + o(1))$, which diverges.
    For the crossing, $\bar{F}(0) = \bar{F}_{\Gamma}(0) = 1$ and $\sum_{y \geq 1} \bar{F}(y) = f \mu = \sum_{y \geq 1} \bar{F}_{\Gamma}(y)$, the predictive mean of a count.
    The difference $\bar{F}(y) - \bar{F}_{\Gamma}(y)$ is therefore positive for all large $y$ and sums to zero over $y \geq 1$, so it is negative for some $y \geq 1$.

    For (iii), \eqref{eq:posterior} gives $b + 2F$ whatever the counts, and the gamma posterior has rate $\beta + F$.
    Substituting both into the rates of (i) gives the display, and $2\beta - b > 0$ by (ii).
\end{proof}

\section{Proof of Proposition~\ref{prop:regret}}
\label{appx:regret}

\begin{lemma}[Pairwise reduction]
    \label{lem:pairwise}
    For every realisation, $\Lambda^{*} R_t \leq \sum_{i \in S^{*}} \sum_{j \notin S^{*}} (\lambda^{*}_i - \lambda^{*}_j) \, \mathbb{I}\{\mu_{j,t} \geq \mu_{i,t}\}$.
\end{lemma}

\begin{proof}
    The sets $S^{*} \setminus S_t$ and $S_t \setminus S^{*}$ have equal size, so a bijection $\sigma$ matches them, and $\Lambda^{*} R_t = \sum_{i \in S^{*} \setminus S_t} (\lambda^{*}_i - \lambda^{*}_{\sigma(i)})$.
    Each term is non-negative, because $i \in S^{*}$ and $\sigma(i) \notin S^{*}$, and has $\mu_{\sigma(i),t} \geq \mu_{i,t}$, because $\sigma(i)$ is selected and $i$ is not.
    So each term appears on the right-hand side, whose other terms are non-negative.
\end{proof}

\begin{lemma}[Bounds on the posterior mean]
    \label{lem:mean_bounds}
    The mean $\mu$ of a belief $\Gig(\lambda \given \nu, a, b)$ with $a, b > 0$ satisfies
    %
    \begin{equation}
        g(\nu) < \mu \leq g(\nu + \epsilon) \,, \qquad g(\alpha) = \frac{\alpha + \sqrt{\alpha^{2} + ab}}{b} \,,
        \label{eq:mean_bounds}
    \end{equation}
    %
    with $\epsilon = \max(\tfrac{1}{2}, -\nu)$.
\end{lemma}

\begin{proof}
    Let $\rho_{\alpha}(z) = (\alpha + \sqrt{\alpha^{2} + z^{2}}) / z$.
    By Lemma~\ref{lem:gig_moments}, $\mu = \eta R_{\nu}(\omega)$ and $g(\alpha) = \eta \rho_{\alpha}(\omega)$, so both bounds are statements about $R$.
    For the lower bound, Eq.~(A.17) of \citet{jorgensen1982statistical} gives $R_{\nu} = \nu / \omega + \sqrt{\nu^{2} / \omega^{2} + D_{\nu}}$ with $D_{\nu} = R_{\nu} / R_{\nu - 1}$, and $D_{\nu} > 1$ by his Theorem~4.1, so $R_{\nu}(\omega) > \rho_{\nu}(\omega)$.

    For the upper bound, fix $\alpha > -\tfrac{1}{2}$ and write $c = \alpha + \tfrac{1}{2}$ and $\rho = \rho_{c}$, which is strictly decreasing and exceeds $1$.
    By Eq.~(A.23) of \citet{jorgensen1982statistical}, $R = R_{\alpha}$ solves $R' = R^{2} - (2c / z) R - 1$, whose right-hand side is positive for $R > \rho$ and negative for $0 < R < \rho$.
    Suppose that $R(z_1) \geq \rho(z_1)$ for some $z_1$.
    Wherever $R = \rho$ we have $R' = 0 > \rho'$, so $R > \rho$ on $(z_1, \infty)$, and there $R' > 0$.
    Then $R(z) > \rho(z_1) > 1$ for all $z > z_1$, which contradicts $R_{\alpha}(z) \to 1$ as $z \to \infty$, his Eq.~(A.21).
    Hence $R_{\alpha} < \rho_{\alpha + 1/2}$, which is the upper bound for $\nu > -\tfrac{1}{2}$.
    The same equation gives $R_{\alpha} > 1$, since its right-hand side is negative wherever $0 < R \leq 1$, so $R$ could not return to its limit $1$.
    For $\nu = -\tfrac{1}{2}$, $R_{\nu} = 1 = \rho_{0}$ by his Eq.~(A.1).
    For $\nu < -\tfrac{1}{2}$, his Eq.~(A.15) gives $R_{\nu} = 1 / R_{-\nu - 1}$ with $-\nu - 1 > -\tfrac{1}{2}$, so $R_{\nu} < 1 = \rho_{\nu + \epsilon}$.
    \claude{Bounds of this form for $K_{\nu+1}/K_{\nu}$ are studied by Segura (2011, J.\ Math.\ Anal.\ Appl.\ 374). If that paper states the upper bound, cite it and drop its proof here.}
\end{proof}

\begin{proof}[Proof of Proposition~\ref{prop:regret}]
    Taking expectations in Lemma~\ref{lem:pairwise} gives \eqref{eq:regret_bound}, so it remains to prove \eqref{eq:misranking}.
    Fix a context $k$ and $\theta \in \mathbb{R}$, and let $M_s = \exp\big(\theta T_{k,s} - \lambda^{*}_k F_{k,s} (\exp(\theta) - 1)\big)$ after $s$ steps.
    Given the past, a step at context $k$ with exposure $f$ multiplies $M$ by $\exp\big(\theta y - \lambda^{*}_k f (\exp(\theta) - 1)\big)$ with $y \sim \mathcal{P}(f \lambda^{*}_k)$, whose expectation is $1$, and a step elsewhere leaves $M$ unchanged.
    So $M$ is a martingale with $M_0 = 1$, and optional stopping at the bounded time $t$ gives $\mathbb{E}[M_t] = 1$.

    The event $\mu_{j,t} \geq \mu_{i,t}$ implies $\mu_{i,t} \leq x$ or $\mu_{j,t} \geq x$.
    The posterior of context $k$ is $\Gig(\lambda \given \nu_k + T_{k,t}, a_k, b_k + 2 F_{k,t})$, and $g$ of Lemma~\ref{lem:mean_bounds}, at the second scale $b_k + 2 F_{k,t}$, is increasing with $g(\alpha) = x$ at $\alpha = x (b_k / 2 + F_{k,t}) - a_k / (2x)$.
    So $g(\nu_k + T_{k,t} + e) \geq x$ exactly when $T_{k,t} \geq x F_{k,t} - \delta_k(x) - e$, for any shift $e$.
    The shift of Lemma~\ref{lem:mean_bounds} at the posterior order $\nu_j + T_{j,t} \geq \nu_j$ is at most $\epsilon_j$, and $g$ is increasing, so $\mu_{j,t} \leq g(\nu_j + T_{j,t} + \epsilon_j)$.
    By Lemma~\ref{lem:mean_bounds}, $\mu_{i,t} \leq x$ therefore implies $T_{i,t} < x F_{i,t} - \delta_i(x)$, and $\mu_{j,t} \geq x$ implies $T_{j,t} \geq x F_{j,t} - \delta_j(x) - \epsilon_j$.
    On the first event take $k = i$ and $\theta = \log(x / \lambda^{*}_i) < 0$.
    Then $\theta T_{i,t} > \theta (x F_{i,t} - \delta_i(x))$, so $M_t > \exp\big(F_{i,t} \, d(x, \lambda^{*}_i) - \theta \delta_i(x)\big) \geq \exp\big(\phi_i \, d(x, \lambda^{*}_i) - \theta \delta_i(x)\big)$, and Markov's inequality gives the first term of \eqref{eq:misranking}.
    On the second take $k = j$ and $\theta = \log(x / \lambda^{*}_j) > 0$, and the same steps with $\delta_j(x) + \epsilon_j$ in place of $\delta_i(x)$ give the second term.
\end{proof}

\begin{proof}[Proof of Corollary~\ref{cor:regret_gamma}]
    The posterior of context $k$ is a gamma law of shape $\nu_k + T_{k,t}$ and rate $b_k / 2 + F_{k,t}$, with mean $(\nu_k + T_{k,t}) / (b_k / 2 + F_{k,t})$.
    So $\mu_{i,t} \leq x$ exactly when $T_{i,t} \leq x F_{i,t} - \delta_i(x)$, and $\mu_{j,t} \geq x$ exactly when $T_{j,t} \geq x F_{j,t} - \delta_j(x)$, with $a_k = 0$ in \eqref{eq:prior_counts}.
    The proof of Proposition~\ref{prop:regret} then applies with $\epsilon_j = 0$.
\end{proof}

\begin{remark}[The Chernoff exponent]
    \label{rem:chernoff}
    Write $A_i(x)$ and $A_j(x)$ for the two terms of \eqref{eq:misranking}, so that $A_i(\lambda^{*}_i) = A_j(\lambda^{*}_j) = 1$.
    For every grid $\lambda^{*}_j = x_0 < x_1 < \dots < x_n = \lambda^{*}_i$,
    %
    \begin{equation}
        \Pr(\mu_{j,t} \geq \mu_{i,t}) \leq A_i(x_0) + \sum_{k=1}^{n} A_i(x_k) A_j(x_{k-1}) + A_j(x_n) \,.
        \label{eq:misranking_grid}
    \end{equation}
    %
    To see this, split the event by the cell of $\mu_{i,t}$ among $(-\infty, x_0]$, $(x_{k-1}, x_k]$ and $(x_n, \infty)$.
    On a middle cell $\mu_{i,t} \leq x_k$ and $\mu_{j,t} > x_{k-1}$, and the product of the martingales of $i$ and $j$, at $x_k$ and $x_{k-1}$, is again a martingale because each step samples one context.
    With a mesh $h$, every exponent in \eqref{eq:misranking_grid} is at least $\Phi_{ij} - \min(\phi_i, \phi_j) \, h \log(\lambda^{*}_i / \lambda^{*}_j)$, where $\Phi_{ij} = \min_x [\phi_i \, d(x, \lambda^{*}_i) + \phi_j \, d(x, \lambda^{*}_j)]$ is the Chernoff exponent of the pair.
    A mesh of order $1 / \min(\phi_i, \phi_j)$ therefore attains $\Phi_{ij}$, at the cost of a prefactor linear in $\min(\phi_i, \phi_j)$, so at small exposures \eqref{eq:misranking} can be the smaller bound.
    Let $\Psi_{ij}$ be the exponent of \eqref{eq:misranking} at its best $x$, where its two exponents cross.
    Since one of them decreases in $x$ and the other increases, $\Psi_{ij} \leq \Phi_{ij} \leq 2 \Psi_{ij}$.
\end{remark}


